---
import Legal from '../layouts/Legal.astro';
import { empresa } from '../data/empresa';
---
<Legal title="Aviso legal">
  <h2>Titular del sitio web</h2>
  <p>{empresa.name} · Titular y NIF: <mark>pendientes</mark><br />{empresa.street}, {empresa.postalCode} {empresa.city} ({empresa.region}) · Teléfono: {empresa.phone.display} · Email: {empresa.email}</p>
  <h2>Propiedad intelectual</h2>
  <p>Las fotografías y el emblema pertenecen a {empresa.name}.</p>
</Legal>
