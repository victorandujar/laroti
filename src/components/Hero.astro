---
/**
 * Portada centrada, como la entrada de una finca: titular en serif fina, una sola acción principal
 * y tres fotos en arco (la central más alta), con dos espigas dibujadas a línea.
 */
import { Image } from 'astro:assets';
import clasico from '../assets/productos/clasico.jpg';
import kamut from '../assets/productos/kamut.jpg';
import cruasan from '../assets/productos/cruasan.jpg';
import Espiga from './Espiga.astro';
import { empresa } from '../data/empresa';
import { ui, home, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const tx = ui[lang];
---
<section aria-labelledby="hero-t" class="relative overflow-x-clip">
  <div class="mx-auto max-w-[88rem] px-5 pt-16 text-center sm:px-10 sm:pt-24">
    <Espiga class="mx-auto mb-7 h-14 text-taronja-2" granos={5} />
    <p class="label text-taronja-2">{tx.hero.eyebrow}</p>
    <h1 id="hero-t" class="titol mx-auto mt-8 max-w-[15ch] text-[clamp(3.3rem,8.2vw,8.4rem)] leading-[0.94]" set:html={tx.hero.h1} />
    <p class="mx-auto mt-8 max-w-[34rem] text-[1.08rem] text-gris">{tx.hero.text}</p>
    <div class="mt-10 flex flex-wrap items-center justify-center gap-x-9 gap-y-5">
      <a href={`${home(lang)}#reserva`} class="btn btn-mar">{tx.hero.cta}</a>
      <a href={`${home(lang)}#hoy`} class="enllac">{tx.hero.hoy}</a>
    </div>
    <p data-estado class="mt-10 inline-flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-[0.92rem] text-gris">
      <span data-punto class="relative inline-block size-1.5 rounded-full bg-linia"></span>
      <span data-e1 class="text-mar">{tx.estado.horario}</span><span aria-hidden="true">·</span><span data-e2></span>
      <span aria-hidden="true">·</span><span>{empresa.street}, {empresa.city}</span>
    </p>
    <p class="cursiva mt-2 text-[1.1rem] text-taronja-2">{tx.mercado}</p>
  </div>

  <div class="relative mx-auto mt-20 max-w-[76rem] px-5 pb-24 sm:mt-24 sm:px-10 sm:pb-32">
    <ul class="grid grid-cols-12 items-end gap-4 sm:gap-8">
      <li class="col-span-4 hidden sm:block">
        <figure>
          <div class="arc" data-reveal="foto" style="--i:1"><div class="arc-in"><Image src={kamut} alt={tx.hero.caps[1]} widths={[360, 560]} sizes="24vw" loading="eager" class="aspect-[3/4] w-full object-cover" /></div></div>
          <figcaption class="cursiva mt-6 text-center text-[1.1rem] text-gris">{tx.hero.caps[1]}</figcaption>
        </figure>
      </li>
      <li class="col-span-12 sm:col-span-4">
        <figure>
          <div class="relative">
          <svg viewBox="0 0 200 200" class="sello absolute -right-8 -top-8 z-10 size-32 sm:-right-12 sm:-top-6 sm:size-36" aria-hidden="true">
            <defs><path id="cercle" d="M100 100 m-74 0 a74 74 0 1 1 148 0 a74 74 0 1 1 -148 0" /></defs>
            <circle cx="100" cy="100" r="96" fill="var(--color-sal)" />
            <circle cx="100" cy="100" r="90" fill="none" stroke="var(--color-linia)" />
            <g class="gira"><text class="sello-txt"><textPath href="#cercle" textLength="462">{tx.sello}</textPath></text></g>
            <text x="100" y="98" text-anchor="middle" class="sello-any">2022</text>
            <text x="100" y="122" text-anchor="middle" class="sello-sub">Campos</text>
          </svg>
          <div class="arc" data-reveal="foto"><div class="arc-in"><Image src={clasico} alt={tx.hero.caps[0]} widths={[400, 640, 900]} sizes="(min-width: 640px) 28vw, 90vw" loading="eager" fetchpriority="high" class="aspect-[3/4.3] w-full object-cover" /></div></div>
          </div>
          <figcaption class="cursiva mt-6 text-center text-[1.1rem] text-gris">{tx.hero.caps[0]}</figcaption>
        </figure>
      </li>
      <li class="col-span-4 hidden sm:block">
        <figure>
          <div class="arc" data-reveal="foto" style="--i:2"><div class="arc-in"><Image src={cruasan} alt={tx.hero.caps[2]} widths={[360, 560]} sizes="24vw" loading="eager" class="aspect-[3/4] w-full object-cover" /></div></div>
          <figcaption class="cursiva mt-6 text-center text-[1.1rem] text-gris">{tx.hero.caps[2]}</figcaption>
        </figure>
      </li>
    </ul>
  </div>
</section>
<style>
  [data-estado][data-abierta="true"] [data-punto] { background: var(--color-verd); }
  [data-estado][data-abierta="true"] [data-punto]::after { content: ''; position: absolute; inset: -4px; border-radius: 999px; border: 1px solid var(--color-verd); opacity: 0; }
  [data-estado][data-abierta="false"] [data-punto] { background: var(--color-taronja-2); }
  @media (prefers-reduced-motion: no-preference) {
    [data-estado][data-abierta="true"] [data-punto]::after { animation: late 2.6s ease-out infinite; }
    @keyframes late { 0% { opacity: 0.9; transform: scale(0.4); } 100% { opacity: 0; transform: scale(2); } }
  }
</style>
<style is:global>
  #hero-t em { color: var(--color-taronja-2); }
  .sello-txt { font-family: var(--font-sans); font-size: 12.5px; font-weight: 500; letter-spacing: 0.24em; text-transform: uppercase; fill: var(--color-mar); }
  .sello-any { font-family: var(--font-serif); font-size: 44px; font-style: italic; fill: var(--color-taronja-2); }
  .sello-sub { font-family: var(--font-sans); font-size: 10px; font-weight: 500; letter-spacing: 0.3em; text-transform: uppercase; fill: var(--color-gris); }
  .gira { transform-origin: 100px 100px; }
  @media (prefers-reduced-motion: no-preference) { .gira { animation: gira 40s linear infinite; } @keyframes gira { to { transform: rotate(360deg); } } }
</style>
