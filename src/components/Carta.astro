---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Espiga from './Espiga.astro';
import { categorias, productos } from '../data/productos';
import { ui, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const tx = ui[lang].productos;
const antiguos = new Set(['xeixa', 'kamut', 'senatore', 'espelta']);
const fotos = import.meta.glob<{ default: ImageMetadata }>('../assets/productos/*.jpg', { eager: true });
const preview = Object.fromEntries(await Promise.all(productos.map(async (p) => [p.id, (await getImage({ src: fotos[`../assets/productos/${p.id}.jpg`]!.default, width: 420, format: 'webp' })).src] as const)));
---
<section id="carta" aria-labelledby="carta-t" class="scroll-mt-20 bg-mares/55">
  <div class="mx-auto max-w-[80rem] px-5 py-28 sm:px-10 sm:py-36">
    <div class="mx-auto max-w-2xl text-center">
      <p class="label text-taronja-2" data-reveal>{tx.label}</p>
      <h2 id="carta-t" class="titol mt-6 text-[clamp(2.8rem,6vw,5.4rem)] font-light" data-reveal style="--i:1" set:html={tx.h2} />
      <p class="mx-auto mt-7 max-w-md text-gris" data-reveal style="--i:2">{tx.sub}</p>
    </div>
    <div class="mt-20 grid gap-x-24 gap-y-20 md:grid-cols-2">
      {categorias.map((c, ci) => (
        <div data-reveal style={`--i:${ci % 2}`}>
          <h3 class="filet"><span class="cursiva text-[1.9rem] text-mar">{c[lang]}</span></h3>
          <ul class="mt-6">
            {productos.filter((p) => p.cat === c.id && !antiguos.has(p.id)).map((p) => (
              <li class="plat py-4" data-preview={preview[p.id]}>
                <div class="flex items-baseline gap-3">
                  <p class="titol text-[1.5rem] leading-tight">{p.nombre}</p>
                  <span class="mb-[0.35rem] flex-1 border-b border-dotted border-mar/30" aria-hidden="true"></span>
                  <p class="cursiva shrink-0 text-[1.05rem] text-gris">{p.formato?.[lang] ?? (p.sinGluten ? tx.sinGlutenCorto : '')}</p>
                </div>
                {p[lang] && <p class="mt-1 max-w-md text-[0.88rem] leading-relaxed text-gris">{p[lang]}{p.formato && p.sinGluten && <span class="cursiva ml-2 text-[1rem] text-verd">· {tx.sinGlutenCorto}</span>}</p>}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div class="mx-auto mt-20 max-w-xl text-center">
      <Espiga class="mx-auto h-12 text-taronja-2" granos={4} />
      <p class="mt-5 text-[0.82rem] leading-relaxed text-gris">{tx.nota}</p>
    </div>
  </div>
  <img data-flota alt="" aria-hidden="true" class="flota" width="240" height="300" />
</section>
<style is:global>
  #carta-t em { color: var(--color-taronja-2); }
  .plat { transition: padding-left 600ms cubic-bezier(0.2, 0.7, 0.2, 1); }
  .flota { position: fixed; left: 0; top: 0; z-index: 30; width: 14rem; height: 17.5rem; object-fit: cover; border-radius: 999px 999px 0 0; pointer-events: none; opacity: 0; scale: 0.9; box-shadow: 0 30px 50px -25px rgb(42 33 27 / 0.55); transition: opacity 400ms, scale 500ms cubic-bezier(0.2, 0.7, 0.2, 1); }
  .flota.on { opacity: 1; scale: 1; }
  @media (hover: hover) and (pointer: fine) { .plat:hover { padding-left: 0.8rem; } }
</style>
<script>
  /* En escritorio, al pasar por un producto de la carta aparece su foto, en arco, junto al cursor. */
  const img = document.querySelector<HTMLImageElement>('[data-flota]');
  const fino = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  if (img && fino) {
    let x = 0, y = 0, cx = 0, cy = 0, raf = 0;
    const loop = () => {
      cx += (x - cx) * 0.16; cy += (y - cy) * 0.16;
      img.style.transform = `translate(${cx + 32}px, ${cy - 150}px)`;
      raf = img.classList.contains('on') ? requestAnimationFrame(loop) : 0;
    };
    for (const li of document.querySelectorAll<HTMLElement>('[data-preview]')) {
      li.addEventListener('mouseenter', (e) => {
        img.src = li.dataset.preview ?? '';
        if (!img.classList.contains('on')) { cx = x = e.clientX; cy = y = e.clientY; }
        img.classList.add('on');
        if (!raf) raf = requestAnimationFrame(loop);
      });
      li.addEventListener('mouseleave', () => img.classList.remove('on'));
    }
    window.addEventListener('mousemove', (e) => { x = e.clientX; y = e.clientY; }, { passive: true });
  }
</script>
