---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { categorias, productos } from '../data/productos';
import { ui, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const tx = ui[lang].productos;
const antiguos = new Set(['xeixa', 'kamut', 'senatore', 'espelta']);
const fotos = import.meta.glob<{ default: ImageMetadata }>('../assets/productos/*.jpg', { eager: true });
const preview = Object.fromEntries(await Promise.all(productos.map(async (p) => [p.id, (await getImage({ src: fotos[`../assets/productos/${p.id}.jpg`]!.default, width: 420, format: 'webp' })).src] as const)));
---
<section id="carta" aria-labelledby="carta-t" class="scroll-mt-20 bg-preseg">
  <div class="mx-auto max-w-[90rem] px-5 py-24 sm:px-10 sm:py-32">
    <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="label hoja text-taronja-2" data-reveal>{tx.label}</p>
        <h2 id="carta-t" class="titol mt-6 text-[clamp(2.7rem,5.4vw,5rem)]" data-reveal style="--i:1" set:html={tx.h2} />
      </div>
      <p class="max-w-md text-gris lg:col-span-4 lg:col-start-9" data-reveal style="--i:2">{tx.sub}</p>
    </div>
    <div class="mt-16 grid gap-x-20 gap-y-16 md:grid-cols-2" data-carta>
      {categorias.map((c, ci) => (
        <div data-reveal style={`--i:${ci % 2}`}>
          <h3 class="flex items-baseline justify-between border-b border-mar pb-3"><span class="label">{c[lang]}</span><span class="text-sm text-gris">0{ci + 1}</span></h3>
          <ul>
            {productos.filter((p) => p.cat === c.id && !antiguos.has(p.id)).map((p) => (
              <li class="plat border-b border-mar/12 py-5" data-preview={preview[p.id]}>
                <div class="flex items-baseline gap-4">
                  <p class="titol text-[1.45rem] leading-tight">{p.nombre}</p>
                  {(p.formato || p.sinGluten) && <span class="mb-[0.4rem] flex-1 border-b border-dotted border-mar/25" aria-hidden="true"></span>}
                  <p class="shrink-0 text-[0.8rem] text-gris">{p.formato?.[lang] ?? ''}{p.sinGluten && <span class="label ml-3 text-verd">{tx.sinGlutenCorto}</span>}</p>
                </div>
                {p[lang] && <p class="mt-1.5 max-w-lg text-[0.88rem] leading-relaxed text-gris">{p[lang]}</p>}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <p class="mt-14 max-w-2xl text-xs leading-relaxed text-gris">{tx.nota}</p>
  </div>
  <img data-flota alt="" aria-hidden="true" class="flota fulla" style="--hoja:url(/hojas/h8.svg)" width="260" height="306" />
</section>
<style is:global>
  #carta-t em { font-style: normal; color: var(--color-taronja-2); }
  .plat { transition: padding-left 500ms cubic-bezier(0.2, 0.7, 0.2, 1); }
  .flota { position: fixed; left: 0; top: 0; z-index: 30; width: 15rem; height: 17.6rem; object-fit: cover; pointer-events: none; opacity: 0; scale: 0.85; transition: opacity 300ms, scale 400ms cubic-bezier(0.2, 0.7, 0.2, 1); }
  .flota.on { opacity: 1; scale: 1; }
  @media (hover: hover) and (pointer: fine) { .plat:hover { padding-left: 1rem; } }
</style>
<script>
  /* En escritorio, al pasar por un producto de la carta aparece su foto junto al cursor. */
  const img = document.querySelector<HTMLImageElement>('[data-flota]');
  const fino = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  if (img && fino) {
    let x = 0, y = 0, cx = 0, cy = 0, raf = 0;
    const loop = () => {
      cx += (x - cx) * 0.18; cy += (y - cy) * 0.18;
      img.style.transform = `translate(${cx + 28}px, ${cy - 140}px)`;
      raf = img.classList.contains('on') ? requestAnimationFrame(loop) : 0;
    };
    for (const li of document.querySelectorAll<HTMLElement>('[data-preview]')) {
      li.addEventListener('mouseenter', (e) => {
        img.src = li.dataset.preview ?? '';
        if (!img.classList.contains('on')) { cx = x = e.clientX; cy = y = e.clientY; }
        img.classList.add('on');
        if (!raf) raf = requestAnimationFrame(loop);
      });
      li.addEventListener('mouseleave', () => img.classList.remove('on'));
    }
    window.addEventListener('mousemove', (e) => { x = e.clientX; y = e.clientY; }, { passive: true });
  }
</script>
