---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Hoy from './Hoy.astro';
import Reserva from './Reserva.astro';
import Granos from './Granos.astro';
import Carta from './Carta.astro';
import Obrador from './Obrador.astro';
import Visita from './Visita.astro';
import Footer from './Footer.astro';
import Schema from './Schema.astro';
import { ui, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const alternates = { es: '/', en: '/en' };
---
<Base title={ui[lang].meta.title} description={ui[lang].meta.description} lang={lang} alternates={alternates}>
  <Schema slot="head" description={ui[lang].meta.description} lang={lang} />
  <Header lang={lang} alternates={alternates} />
  <main id="contenido">
    <Hero lang={lang} />
    <Hoy lang={lang} />
    <Reserva lang={lang} />
    <Granos lang={lang} />
    <Obrador lang={lang} />
    <Carta lang={lang} />
    <Visita lang={lang} />
  </main>
  <Footer lang={lang} />
  <script>
    import '../scripts/tienda';
  </script>
</Base>
