---
import emblema from '../assets/emblema.png';
import { empresa } from '../data/empresa';
import { isDemo } from '../lib/site';
import { ui, type Lang } from '../i18n/ui';
interface Props { lang?: Lang }
const { lang = 'es' } = Astro.props;
const tx = ui[lang].footer;
---
<footer class="fosc bg-garrover pb-20 text-sal lg:pb-0">
  <div class="mx-auto max-w-[80rem] px-5 pt-20 text-center sm:px-10">
    <img src={emblema.src} width="56" height="56" alt="" class="mx-auto size-14" loading="lazy" />
    <p class="titol mt-6 text-[clamp(3.4rem,8vw,6.5rem)] leading-none">Larotî</p>
    <p class="cursiva mt-4 text-[1.3rem] text-sal/70">{tx.desc}</p>
    <div class="mt-16 flex flex-wrap items-center justify-between gap-6 border-t border-sal/15 py-8 text-[0.85rem] text-sal/70">
      <p>{empresa.street}, {empresa.postalCode} {empresa.city}, {empresa.region}</p>
      <ul class="flex flex-wrap gap-7">
        {isDemo && <li><a href="/gestion" class="text-[#e0a46a] hover:text-sal">{tx.panel}</a></li>}
        <li><a href="/aviso-legal" class="hover:text-sal">{tx.avis}</a></li>
        <li><a href="/privacidad" class="hover:text-sal">{tx.priv}</a></li>
      </ul>
    </div>
  </div>
</footer>
