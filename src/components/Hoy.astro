---
/**
 * «Hoy, en el mostrador»: una carta del día impresa, con doble filete. La edita el obrador desde /gestion.
 * Cada pieza disponible lleva un «+» para guardarla en la reserva.
 */
import Espiga from './Espiga.astro';
import { productos } from '../data/productos';
import { ui, home, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const tx = ui[lang].hoy;
---
<section id="hoy" aria-labelledby="hoy-t" class="scroll-mt-20 bg-mares/55 py-24 sm:py-32">
  <div class="mx-auto max-w-[68rem] px-4 sm:px-10">
    <div class="carta-dia" data-reveal>
      <div class="text-center">
        <Espiga class="mx-auto h-16 text-taronja-2" granos={5} />
        <p class="label mt-6 text-gris"><span data-hoy-fecha>&nbsp;</span></p>
        <h2 id="hoy-t" class="titol mt-5 text-[clamp(2.7rem,5.6vw,4.6rem)] font-light" set:html={tx.h2} />
        <p class="mx-auto mt-5 max-w-md text-[0.98rem] text-gris" data-hoy-texto>{tx.text}</p>
      </div>
      <div class="filet mx-auto mt-10 max-w-lg" aria-hidden="true"><span class="cursiva text-lg">✦</span></div>
      <ul class="mt-8 grid gap-x-14 sm:grid-cols-2" data-tablon>
        {productos.map((p) => (
          <li data-hoy={p.id} hidden class="fila">
            <span class="nom titol">{p.nombre}</span>
            <span class="punts" aria-hidden="true"></span>
            <span data-disp class="disp cursiva"></span>
            <button type="button" data-quick={p.id} data-nom={p.nombre} class="mes" aria-label={`${tx.reservar}: ${p.nombre}`}>+</button>
          </li>
        ))}
      </ul>
      <p data-hoy-nada hidden class="cursiva py-8 text-center text-2xl text-gris">{tx.nada}</p>
      <p class="mt-10 text-center"><a href={`${home(lang)}#reserva`} class="enllac">{tx.nota}</a></p>
    </div>
  </div>
</section>
<div data-toast role="status" aria-live="polite" class="toast"><span data-toast-txt></span> <a href="#reserva" class="ml-3 underline underline-offset-4">{tx.ver}</a></div>
<style>
  .carta-dia { position: relative; background: var(--color-sal); padding: clamp(2.5rem, 6vw, 4.5rem) clamp(1.4rem, 5vw, 4.5rem); box-shadow: 0 30px 60px -40px rgb(42 33 27 / 0.45); }
  .carta-dia::before { content: ''; position: absolute; inset: 0.7rem; border: 1px solid var(--color-linia); pointer-events: none; }
  .carta-dia::after { content: ''; position: absolute; inset: 1.05rem; border: 1px solid var(--color-linia); opacity: 0.6; pointer-events: none; }
  .fila { position: relative; z-index: 1; display: flex; align-items: baseline; gap: 0.7rem; padding: 0.7rem 0; }
  .nom { font-size: 1.6rem; line-height: 1.15; font-weight: 400; }
  .punts { flex: 1; min-width: 1rem; border-bottom: 1px dotted rgb(42 33 27 / 0.3); translate: 0 -0.3rem; }
  .disp { font-size: 1.05rem; white-space: nowrap; color: var(--color-gris); }
  .fila[data-estado="hay"] .disp { color: var(--color-verd); }
  .fila[data-estado="pocos"] .disp { color: var(--color-taronja-2); }
  .fila[data-estado="agotado"] .nom { color: rgb(42 33 27 / 0.4); text-decoration: line-through; text-decoration-thickness: 1px; }
  .fila[data-estado="agotado"] .mes { visibility: hidden; }
  .mes { display: grid; place-items: center; width: 1.8rem; height: 1.8rem; flex: none; border: 1px solid var(--color-linia); border-radius: 999px; font-size: 1rem; line-height: 1; color: var(--color-gris); transition: background-color 300ms, color 300ms, border-color 300ms; translate: 0 0.15rem; }
  .mes:hover { background: var(--color-mar); border-color: var(--color-mar); color: var(--color-sal); }
  .toast { position: fixed; left: 50%; bottom: 1.5rem; z-index: 60; translate: -50% 1rem; opacity: 0; pointer-events: none; max-width: calc(100vw - 2rem); padding: 0.95rem 1.4rem; background: var(--color-mar); color: var(--color-sal); font-size: 0.92rem; transition: opacity 400ms, translate 500ms cubic-bezier(0.2, 0.7, 0.2, 1); }
  .toast.on { opacity: 1; translate: -50% 0; pointer-events: auto; }
</style>
<style is:global>#hoy-t em { color: var(--color-verd); }</style>
