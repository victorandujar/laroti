---
/**
 * «Hoy en el obrador»: el mostrador en vivo, con fotos. Desde cada pieza se puede reservar para otro día.
 * Los estados los cambia el obrador desde /gestion; los pinta scripts/tienda.ts.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { productos } from '../data/productos';
import { ui, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const tx = ui[lang].hoy;
const fotos = import.meta.glob<{ default: ImageMetadata }>('../assets/productos/*.jpg', { eager: true });
---
<section id="hoy" aria-labelledby="hoy-t" class="scroll-mt-20 bg-salvia">
  <div class="mx-auto max-w-[90rem] px-5 pt-24 sm:px-10 sm:pt-32">
    <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="label flex items-center gap-3 text-verd" data-reveal><span class="relative inline-flex size-2 rounded-full bg-verd"><span class="viu absolute inset-0 rounded-full bg-verd"></span></span><span data-hoy-fecha class="first-letter:uppercase">&nbsp;</span></p>
        <h2 id="hoy-t" class="titol mt-6 text-[clamp(2.7rem,5.4vw,5rem)]" data-reveal style="--i:1" set:html={tx.h2} />
      </div>
      <div class="lg:col-span-4 lg:col-start-9" data-reveal style="--i:2">
        <p class="text-gris" data-hoy-texto>{tx.text}</p>
        <div class="mt-6 flex items-center gap-3" aria-hidden="true">
          <button type="button" data-mov="-1" class="flecha" tabindex="-1">←</button>
          <button type="button" data-mov="1" class="flecha" tabindex="-1">→</button>
        </div>
      </div>
    </div>
  </div>
  <ul class="mostrador mt-12 flex snap-x snap-mandatory gap-5 overflow-x-auto px-5 pb-24 sm:px-10 sm:pb-32" data-tablon aria-label={tx.label}>
    {productos.map((p) => (
      <li data-hoy={p.id} hidden class="peca">
        <div class="relative overflow-hidden bg-salvia-2">
          <Image src={fotos[`../assets/productos/${p.id}.jpg`]!.default} alt="" widths={[300, 460]} sizes="17rem" loading="lazy" class="aspect-[4/5] w-full object-cover" />
          <span data-disp class="disp"></span>
        </div>
        <p class="titol mt-4 text-[1.4rem] leading-tight">{p.nombre}</p>
        <p class="mt-0.5 text-[0.8rem] text-gris">{p.formato?.[lang] ?? ' '}</p>
        <button type="button" data-quick={p.id} data-nom={p.nombre} class="enllac mt-4">{tx.reservar}</button>
      </li>
    ))}
    <li data-hoy-nada hidden class="titol py-10 text-3xl text-gris">{tx.nada}</li>
  </ul>
</section>
<div data-toast role="status" aria-live="polite" class="toast"><span data-toast-txt></span> <a href="#reserva" class="ml-3 underline underline-offset-4">{tx.ver}</a></div>
<style>
  .mostrador { scrollbar-width: none; scroll-padding-inline: 1.25rem; }
  @media (min-width: 640px) { .mostrador { scroll-padding-inline: 2.5rem; } }
  @media (min-width: 90rem) { .mostrador { padding-inline: calc((100vw - 90rem) / 2 + 2.5rem); scroll-padding-inline: calc((100vw - 90rem) / 2 + 2.5rem); } }
  .mostrador::-webkit-scrollbar { display: none; }
  .peca { flex: 0 0 auto; width: min(17rem, 68vw); scroll-snap-align: start; }
  .peca img { transition: transform 1200ms cubic-bezier(0.2, 0.7, 0.2, 1); }
  .peca:hover img { transform: scale(1.04); }
  .disp { position: absolute; left: 0.75rem; top: 0.75rem; display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.4rem 0.7rem; background: rgb(246 242 235 / 0.92); backdrop-filter: blur(6px); font-size: 0.78rem; font-weight: 600; border-radius: 999px; }
  .disp::before { content: ''; width: 0.4rem; height: 0.4rem; border-radius: 999px; background: currentColor; }
  .peca[data-estado="hay"] .disp { color: var(--color-verd); }
  .peca[data-estado="pocos"] .disp { color: var(--color-taronja-2); }
  .peca[data-estado="agotado"] .disp { color: var(--color-gris); }
  .peca[data-estado="agotado"] img { filter: grayscale(1) opacity(0.55); }
  .peca[data-estado="agotado"] .titol { color: rgb(22 27 39 / 0.45); }
  .flecha { display: grid; place-items: center; width: 3rem; height: 3rem; border: 1px solid var(--color-mar); border-radius: 999px; transition: background-color 300ms, color 300ms; }
  .flecha:hover { background: var(--color-mar); color: var(--color-sal); }
  .toast { position: fixed; left: 50%; bottom: 1.5rem; z-index: 60; translate: -50% 1rem; opacity: 0; pointer-events: none; max-width: calc(100vw - 2rem); padding: 0.9rem 1.3rem; background: var(--color-mar); color: var(--color-sal); font-size: 0.9rem; transition: opacity 300ms, translate 400ms cubic-bezier(0.2, 0.7, 0.2, 1); }
  .toast.on { opacity: 1; translate: -50% 0; pointer-events: auto; }
  @media (prefers-reduced-motion: no-preference) {
    .viu { animation: viu 2.2s ease-out infinite; }
    @keyframes viu { from { transform: scale(1); opacity: 0.7; } to { transform: scale(3); opacity: 0; } }
  }
</style>
<style is:global>#hoy-t em { font-style: normal; color: var(--color-verd); }</style>
<script>
  const m = document.querySelector<HTMLElement>('.mostrador');
  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-mov]')) {
    b.addEventListener('click', () => m?.scrollBy({ left: Number(b.dataset.mov) * Math.min(m.clientWidth * 0.8, 900), behavior: 'smooth' }));
  }
</script>
