---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { porId } from '../data/productos';
import { ui, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const tx = ui[lang].granos;
const fotos = import.meta.glob<{ default: ImageMetadata }>('../assets/productos/*.jpg', { eager: true });
const granos = ['xeixa', 'kamut', 'senatore', 'espelta'] as const;
---
<section id="granos" aria-labelledby="gra-t" class="fosc scroll-mt-20 bg-mar text-sal">
  <div class="mx-auto max-w-[90rem] px-5 py-24 sm:px-10 sm:py-32">
    <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="label hoja text-sal/55" data-reveal>{tx.label}</p>
        <h2 id="gra-t" class="titol mt-6 text-[clamp(2.7rem,5.4vw,5rem)]" data-reveal style="--i:1" set:html={tx.h2} />
      </div>
      <div class="lg:col-span-4 lg:col-start-9" data-reveal style="--i:2">
        <p class="text-sal/70">{tx.text}</p>
        <p class="label mt-6 text-taronja">{tx.finca}</p>
      </div>
    </div>
    <ol class="mt-20 grid grid-cols-2 gap-x-5 gap-y-14 lg:grid-cols-4 lg:gap-x-8">
      {granos.map((id, i) => {
        const p = porId.get(id)!;
        return (
          <li class="gra">
            <div class="overflow-hidden" data-reveal="foto" style={`--i:${i}`}>
              <Image src={fotos[`../assets/productos/${id}.jpg`]!.default} alt={p.nombre} widths={[320, 480, 640]} sizes="(min-width: 1024px) 22vw, 46vw" loading="lazy" class="aspect-[4/5] w-full object-cover" />
            </div>
            <p class="num mt-6 text-sm text-sal/45">0{i + 1}</p>
            <h3 class="titol mt-2 text-[clamp(1.6rem,2.4vw,2.2rem)] leading-[1.05]">{p.nombre}</h3>
            <p class="label mt-3 text-sal/55">{p.formato?.[lang]}</p>
            <p class="mt-4 border-t border-sal/15 pt-4 text-[0.9rem] leading-relaxed text-sal/65">{p[lang]}</p>
          </li>
        );
      })}
    </ol>
  </div>
</section>
<style is:global>
  #gra-t em { font-style: normal; color: var(--color-taronja); }
  .gra img { transition: transform 1600ms cubic-bezier(0.2, 0.7, 0.2, 1); }
  .gra:hover img { transform: scale(1.05); }
</style>
