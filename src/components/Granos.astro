---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Espiga from './Espiga.astro';
import { porId } from '../data/productos';
import { ui, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const tx = ui[lang].granos;
const fotos = import.meta.glob<{ default: ImageMetadata }>('../assets/productos/*.jpg', { eager: true });
const granos = ['xeixa', 'kamut', 'senatore', 'espelta'] as const;
const romans = ['I', 'II', 'III', 'IV'];
---
<section id="granos" aria-labelledby="gra-t" class="fosc scroll-mt-20 bg-garrover text-sal">
  <div class="mx-auto max-w-[88rem] px-5 py-28 sm:px-10 sm:py-36">
    <div class="mx-auto max-w-4xl text-center">
      <Espiga class="mx-auto h-20 text-taronja" granos={6} />
      <p class="label mt-8 text-taronja" data-reveal>{tx.label}</p>
      <h2 id="gra-t" class="titol mt-6 text-[clamp(2.6rem,5.2vw,4.9rem)]" data-reveal style="--i:1" set:html={tx.h2} />
      <p class="mx-auto mt-7 max-w-xl text-sal/75" data-reveal style="--i:2">{tx.text}</p>
      <p class="cursiva mt-5 text-[1.25rem] text-taronja" data-reveal style="--i:3">{tx.finca}</p>
    </div>
    <ol class="mt-24 grid grid-cols-2 gap-x-6 gap-y-16 lg:grid-cols-4 lg:gap-x-10">
      {granos.map((id, i) => {
        const p = porId.get(id)!;
        return (
          <li class="gra text-center">
            <div class="arc" data-reveal="foto" style={`--i:${i}`}>
              <div class="arc-in"><Image src={fotos[`../assets/productos/${id}.jpg`]!.default} alt={p.nombre} widths={[320, 480, 640]} sizes="(min-width: 1024px) 20vw, 44vw" loading="lazy" class="aspect-[3/4] w-full object-cover" /></div>
            </div>
            <p class="num mt-9 text-[1.1rem] text-[#e0a46a]">{romans[i]}</p>
            <h3 class="titol mt-2 text-[clamp(1.7rem,2.6vw,2.3rem)] font-normal leading-[1.05]">{p.nombre}</h3>
            <p class="cursiva mt-2 text-[1.1rem] text-sal/65">{p.formato?.[lang]}</p>
            <p class="mx-auto mt-5 max-w-[17rem] text-[0.88rem] leading-relaxed text-sal/60">{p[lang]}</p>
          </li>
        );
      })}
    </ol>
  </div>
</section>
<style is:global>
  #gra-t em { color: var(--color-taronja); }
  .gra img { transition: transform 1800ms cubic-bezier(0.2, 0.7, 0.2, 1); }
  .gra:hover img { transform: scale(1.05); }
</style>
