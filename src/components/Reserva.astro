---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { isDemo } from '../lib/site';
import { categorias, productos } from '../data/productos';
import { ui, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const tx = ui[lang].reserva;
const g = ui[lang];
const fotos = import.meta.glob<{ default: ImageMetadata }>('../assets/productos/*.jpg', { eager: true });
---
<section id="reserva" aria-labelledby="res-t" class="scroll-mt-20 border-t border-linia bg-sal-2/60">
  <div class="mx-auto max-w-[90rem] px-5 py-24 sm:px-10 sm:py-32">
    <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="label hoja text-gris" data-reveal>{tx.label}</p>
        <h2 id="res-t" class="titol mt-6 text-[clamp(2.7rem,5.4vw,5rem)]" data-reveal style="--i:1" set:html={tx.h2} />
      </div>
      <p class="max-w-md text-gris lg:col-span-4 lg:col-start-9" data-reveal style="--i:2">{tx.text}</p>
    </div>

    <div class="mt-16 grid gap-14 lg:grid-cols-12" data-reserva>
      <div class="min-w-0 lg:col-span-8">
        <fieldset class="min-w-0">
          <legend class="label text-gris">{tx.dia}</legend>
          <div data-dias class="mt-5 flex gap-2 overflow-x-auto pb-1 [scrollbar-width:none]"></div>
        </fieldset>

        <fieldset class="mt-14 min-w-0">
          <legend class="label text-gris">{tx.que}</legend>
          <div class="mt-5 flex flex-wrap gap-x-7 gap-y-3 border-b border-linia" role="group" aria-label={tx.que}>
            <button type="button" data-rfiltro="todo" aria-pressed="true" class="tab">{g.productos.todo}</button>
            {categorias.map((c) => <button type="button" data-rfiltro={c.id} aria-pressed="false" class="tab">{c[lang]}</button>)}
          </div>
          <ul class="mt-8 grid grid-cols-2 gap-x-5 gap-y-10 sm:grid-cols-3 xl:grid-cols-4">
            {productos.map((p) => (
              <li data-item={p.id} data-cat={p.cat} class="tile">
                <button type="button" data-mas class="foto-btn" aria-label={`${g.mas}: ${p.nombre}`}>
                  <Image src={fotos[`../assets/productos/${p.id}.jpg`]!.default} alt="" widths={[260, 400]} sizes="(min-width: 1280px) 15vw, (min-width: 640px) 28vw, 44vw" loading="lazy" class="aspect-[4/5] w-full object-cover" />
                  <span data-badge class="badge num" aria-hidden="true">0</span>
                </button>
                <p class="titol mt-4 text-[1.35rem] leading-[1.1]">{p.nombre}</p>
                <p class="mt-1 text-[0.8rem] text-gris">{p.formato?.[lang] ?? ' '}</p>
                <div class="ctl mt-3">
                  <button type="button" data-menos aria-label={`${g.quitar}: ${p.nombre}`}>−</button>
                  <span data-qty class="num" aria-live="polite">0</span>
                  <button type="button" data-mas aria-label={`${g.mas}: ${p.nombre}`}>+</button>
                  <button type="button" data-mas class="afegir" aria-hidden="true" tabindex="-1">{g.anadir}</button>
                </div>
              </li>
            ))}
          </ul>
        </fieldset>
      </div>

      <div class="min-w-0 lg:col-span-4">
        <div class="resum lg:sticky lg:top-28">
          <div data-paso="form">
            <p class="label text-gris">{tx.resumen}</p>
            <p data-dia-txt class="titol mt-4 text-[2.1rem] leading-tight first-letter:uppercase">&nbsp;</p>
            <p data-vacio class="mt-6 border-t border-linia pt-6 text-sm text-gris">{tx.vacio}</p>
            <ul data-lineas class="mt-6 space-y-2 border-t border-linia pt-6"></ul>
            <form data-form class="mt-8 grid gap-5" novalidate>
              <label class="block"><span class="label text-gris">{tx.nombre}</span><input name="nombre" required autocomplete="given-name" maxlength="60" class="camp" /></label>
              <label class="block"><span class="label text-gris">{tx.telefono}</span><input name="telefono" required type="tel" inputmode="tel" autocomplete="tel" maxlength="20" class="camp" /></label>
              <label class="block"><span class="label text-gris">{tx.nota} <span class="normal-case tracking-normal">{tx.opcional}</span></span><input name="nota" maxlength="140" class="camp" /></label>
              <p data-error hidden role="alert" class="border-l-2 border-taronja-2 pl-3 text-sm text-taronja-2"></p>
              <button type="submit" class="btn btn-mar mt-2 w-full">{tx.cta}</button>
              <p class="text-xs leading-relaxed text-gris">{isDemo ? tx.demo : tx.paga}</p>
            </form>
          </div>
          <div data-paso="ok" hidden>
            <p class="label text-verd">{tx.ok}</p>
            <p class="titol mt-4 text-[2.4rem] leading-tight">{tx.gracias} <em><span data-ok-nombre></span></em>.</p>
            <div class="mt-7 border-y border-linia py-6">
              <p class="label text-gris">{tx.codigo}</p>
              <p data-ok-codigo class="num mt-2 text-[3.4rem] leading-none tracking-[0.12em]">----</p>
              <ul data-ok-lineas class="mt-5 space-y-1 text-[0.95rem]"></ul>
              <p class="mt-4 text-sm text-gris"><span class="text-mar">{tx.recoge}</span> <span data-ok-dia></span>, {tx.de8a14}. {tx.paga}</p>
            </div>
            <a data-ok-wa href="#" target="_blank" rel="noopener" class="btn btn-mar mt-7 w-full">{tx.wa}</a>
            {isDemo && <a href="/gestion" class="btn btn-line mt-3 w-full">{tx.panel}</a>}
            <button type="button" data-otra class="enllac mx-auto mt-6 flex w-fit">{tx.otra}</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<div data-barra hidden class="fixed inset-x-0 bottom-0 z-30 border-t border-mar bg-mar px-5 py-3 lg:hidden">
  <a href="#reserva" class="fosc flex items-center justify-between text-sal"><span class="label">{g.barra}</span><span data-barra-piezas class="text-sm"></span></a>
</div>
<style is:global>
  #res-t em { font-style: normal; color: var(--color-taronja-2); }
  .tab { position: relative; padding-bottom: 0.8rem; font-size: 0.98rem; font-weight: 600; color: var(--color-gris); transition: color 300ms; }
  .tab::after { content: ''; position: absolute; left: 0; right: 0; bottom: -1px; height: 1px; background: var(--color-mar); transform: scaleX(0); transform-origin: left; transition: transform 400ms cubic-bezier(0.2, 0.7, 0.2, 1); }
  .tab:hover { color: var(--color-mar); }
  .tab[aria-pressed="true"] { color: var(--color-mar); }
  .tab[aria-pressed="true"]::after { transform: scaleX(1); }
  .dia { flex: 0 0 auto; display: grid; justify-items: start; min-width: 6.2rem; padding: 0.85rem 1rem 0.8rem; border: 1px solid var(--color-linia); background: transparent; text-align: left; cursor: pointer; transition: background-color 300ms, color 300ms, border-color 300ms; }
  .dia:hover { border-color: var(--color-mar); }
  .dia[aria-pressed="true"] { background: var(--color-mar); border-color: var(--color-mar); color: var(--color-sal); }
  .dia .d { font-size: 0.85rem; font-weight: 600; opacity: 0.7; }
  .dia .n { font-family: var(--font-serif); font-size: 2.3rem; line-height: 1; margin-top: 0.35rem; }
  .dia .m { font-size: 0.78rem; opacity: 0.8; }
  .foto-btn { position: relative; display: block; width: 100%; overflow: hidden; background: var(--color-sal-2); }
  .foto-btn img { transition: transform 1200ms cubic-bezier(0.2, 0.7, 0.2, 1), filter 600ms; }
  .tile:hover .foto-btn img { transform: scale(1.045); }
  .foto-btn::after { content: ''; position: absolute; inset: 0; box-shadow: inset 0 0 0 0 var(--color-mar); transition: box-shadow 400ms; pointer-events: none; }
  .tile.on .foto-btn::after { box-shadow: inset 0 0 0 2px var(--color-mar); }
  .badge { position: absolute; left: 0.75rem; top: 0.75rem; display: grid; place-items: center; width: 2.2rem; height: 2.2rem; border-radius: 999px; background: var(--color-mar); color: var(--color-sal); font-size: 1.15rem; opacity: 0; transform: translateY(-4px); transition: opacity 300ms, transform 300ms; }
  .tile.on .badge { opacity: 1; transform: none; }
  .ctl { display: flex; align-items: center; gap: 0.25rem; height: 2.25rem; }
  .ctl button { display: grid; place-items: center; min-width: 2.25rem; height: 2.25rem; border: 1px solid var(--color-linia); font-size: 1.05rem; transition: border-color 300ms, background-color 300ms; }
  .ctl button:hover { border-color: var(--color-mar); }
  .ctl [data-qty] { min-width: 2rem; text-align: center; font-size: 1.25rem; }
  .ctl .afegir { padding: 0 1rem; border-radius: 999px; font-size: 0.88rem; font-weight: 600; }
  .tile:not(.on) .ctl > :not(.afegir) { display: none; }
  .tile.on .ctl .afegir { display: none; }
  .resum { border: 1px solid var(--color-linia); background: #fbf8f3; padding: 2rem 1.75rem; }
  @media (min-width: 640px) { .resum { padding: 2.5rem 2.25rem; } }
</style>
