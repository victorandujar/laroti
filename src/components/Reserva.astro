---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { isDemo } from '../lib/site';
import { categorias, productos } from '../data/productos';
import { ui, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const tx = ui[lang].reserva;
const g = ui[lang];
const fotos = import.meta.glob<{ default: ImageMetadata }>('../assets/productos/*.jpg', { eager: true });
---
<section id="reserva" aria-labelledby="res-t" class="scroll-mt-20">
  <div class="mx-auto max-w-[88rem] px-5 py-28 sm:px-10 sm:py-36">
    <div class="mx-auto max-w-2xl text-center">
      <p class="label text-taronja-2" data-reveal>{tx.label}</p>
      <h2 id="res-t" class="titol mt-6 text-[clamp(2.8rem,6vw,5.4rem)] font-light" data-reveal style="--i:1" set:html={tx.h2} />
      <p class="mx-auto mt-7 max-w-lg text-gris" data-reveal style="--i:2">{tx.text}</p>
    </div>

    <div class="mt-20 grid gap-16 lg:grid-cols-12 lg:gap-12" data-reserva>
      <div class="min-w-0 lg:col-span-8">
        <fieldset class="min-w-0">
          <legend class="pas"><span class="num">I</span>{tx.dia}</legend>
          <div data-dias class="mt-6 flex gap-2.5 overflow-x-auto pb-2 [scrollbar-width:none]"></div>
        </fieldset>

        <fieldset class="mt-16 min-w-0">
          <legend class="pas"><span class="num">II</span>{tx.que}</legend>
          <div class="mt-6 flex flex-wrap gap-x-8 gap-y-3 border-b border-linia" role="group" aria-label={tx.que}>
            <button type="button" data-rfiltro="todo" aria-pressed="true" class="tab">{g.productos.todo}</button>
            {categorias.map((c) => <button type="button" data-rfiltro={c.id} aria-pressed="false" class="tab">{c[lang]}</button>)}
          </div>
          <ul class="mt-10 grid grid-cols-2 gap-x-5 gap-y-12 sm:grid-cols-3 xl:grid-cols-4">
            {productos.map((p) => (
              <li data-item={p.id} data-cat={p.cat} class="tile text-center">
                <button type="button" data-mas class="foto-btn" aria-label={`${g.mas}: ${p.nombre}`}>
                  <Image src={fotos[`../assets/productos/${p.id}.jpg`]!.default} alt="" widths={[260, 400]} sizes="(min-width: 1280px) 14vw, (min-width: 640px) 27vw, 44vw" loading="lazy" class="aspect-[4/5] w-full object-cover" />
                  <span data-badge class="badge num" aria-hidden="true">0</span>
                </button>
                <p class="titol mt-4 text-[1.35rem] leading-[1.1]">{p.nombre}</p>
                <p class="cursiva mt-0.5 text-[1rem] text-gris">{p.formato?.[lang] ?? ' '}</p>
                <div class="ctl mt-3">
                  <button type="button" data-menos aria-label={`${g.quitar}: ${p.nombre}`}>−</button>
                  <span data-qty class="num" aria-live="polite">0</span>
                  <button type="button" data-mas aria-label={`${g.mas}: ${p.nombre}`}>+</button>
                  <button type="button" data-mas class="afegir" aria-hidden="true" tabindex="-1">{g.anadir}</button>
                </div>
              </li>
            ))}
          </ul>
        </fieldset>
      </div>

      <div class="min-w-0 lg:col-span-4">
        <div class="albara lg:sticky lg:top-28">
          <div data-paso="form">
            <p class="pas !mb-0"><span class="num">III</span>{tx.resumen}</p>
            <p data-dia-txt class="cursiva mt-4 text-[1.9rem] leading-tight text-taronja-2 first-letter:uppercase">&nbsp;</p>
            <p data-vacio class="mt-6 border-t border-linia pt-6 text-[0.95rem] text-gris">{tx.vacio}</p>
            <ul data-lineas class="mt-6 space-y-2 border-t border-linia pt-6"></ul>
            <form data-form class="mt-8 grid gap-6" novalidate>
              <label class="block"><span class="label text-gris">{tx.nombre}</span><input name="nombre" required autocomplete="given-name" maxlength="60" class="camp" /></label>
              <label class="block"><span class="label text-gris">{tx.telefono}</span><input name="telefono" required type="tel" inputmode="tel" autocomplete="tel" maxlength="20" class="camp" /></label>
              <label class="block"><span class="label text-gris">{tx.nota} <span class="normal-case tracking-normal">{tx.opcional}</span></span><input name="nota" maxlength="140" class="camp" /></label>
              <p data-error hidden role="alert" class="cursiva text-[1.05rem] text-taronja-2"></p>
              <button type="submit" class="btn btn-mar mt-2 w-full">{tx.cta}</button>
              <p class="text-center text-xs leading-relaxed text-gris">{isDemo ? tx.demo : tx.paga}</p>
            </form>
          </div>
          <div data-paso="ok" hidden class="text-center">
            <p class="label text-verd">{tx.ok}</p>
            <p class="titol mt-5 text-[2.6rem] font-light leading-tight">{tx.gracias} <em><span data-ok-nombre></span></em>.</p>
            <div class="mt-8 border-y border-linia py-7">
              <p class="label text-gris">{tx.codigo}</p>
              <p data-ok-codigo class="num mt-3 text-[3.6rem] leading-none tracking-[0.14em]">----</p>
              <ul data-ok-lineas class="mt-6 space-y-1 text-[0.95rem]"></ul>
              <p class="cursiva mt-4 text-[1.1rem] text-gris"><span data-ok-dia></span>, {tx.de8a14}. {tx.paga}</p>
            </div>
            <a data-ok-wa href="#" target="_blank" rel="noopener" class="btn btn-mar mt-8 w-full">{tx.wa}</a>
            {isDemo && <a href="/gestion" class="btn btn-line mt-3 w-full">{tx.panel}</a>}
            <button type="button" data-otra class="enllac mx-auto mt-7">{tx.otra}</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<div data-barra hidden class="fixed inset-x-0 bottom-0 z-30 bg-mar px-5 py-3.5 lg:hidden">
  <a href="#reserva" class="fosc flex items-center justify-between text-sal"><span class="label">{g.barra}</span><span data-barra-piezas class="cursiva text-[1.1rem]"></span></a>
</div>
<style is:global>
  #res-t em { color: var(--color-taronja-2); }
  .pas { display: flex; align-items: baseline; gap: 0.9rem; margin-bottom: 0; font-family: var(--font-serif); font-size: 1.75rem; font-weight: 400; line-height: 1.1; }
  .pas .num { color: var(--color-taronja-2); font-size: 1.1rem; font-style: italic; min-width: 1.6rem; }
  .tab { position: relative; padding-bottom: 0.9rem; font-size: 0.68rem; font-weight: 500; letter-spacing: 0.28em; text-transform: uppercase; color: var(--color-gris); transition: color 400ms; }
  .tab::after { content: ''; position: absolute; left: 0; right: 0; bottom: -1px; height: 1px; background: var(--color-taronja-2); transform: scaleX(0); transition: transform 500ms cubic-bezier(0.2, 0.7, 0.2, 1); }
  .tab:hover, .tab[aria-pressed="true"] { color: var(--color-mar); }
  .tab[aria-pressed="true"]::after { transform: scaleX(1); }
  .dia { flex: 0 0 auto; display: grid; justify-items: center; width: 5.6rem; padding: 1.1rem 0 0.9rem; border: 1px solid var(--color-linia); border-radius: 999px 999px 0 0; background: transparent; cursor: pointer; transition: background-color 400ms, color 400ms, border-color 400ms; }
  .dia:hover { border-color: var(--color-mar); }
  .dia[aria-pressed="true"] { background: var(--color-mar); border-color: var(--color-mar); color: var(--color-sal); }
  .dia .d { font-size: 0.62rem; font-weight: 500; letter-spacing: 0.24em; text-transform: uppercase; opacity: 0.85; }
  .dia .n { font-family: var(--font-serif); font-size: 2.4rem; font-weight: 400; line-height: 1; margin-top: 0.3rem; }
  .dia .m { font-family: var(--font-serif); font-style: italic; font-size: 1rem; opacity: 0.85; }
  .foto-btn { position: relative; display: block; width: 100%; overflow: hidden; border-radius: 999px 999px 0 0; background: var(--color-sal-2); }
  .foto-btn img { transition: transform 1600ms cubic-bezier(0.2, 0.7, 0.2, 1); }
  .tile:hover .foto-btn img { transform: scale(1.05); }
  .foto-btn::after { content: ''; position: absolute; inset: 0; border-radius: inherit; box-shadow: inset 0 0 0 0 var(--color-taronja-2); transition: box-shadow 500ms; pointer-events: none; }
  .tile.on .foto-btn::after { box-shadow: inset 0 0 0 3px var(--color-taronja-2); }
  .badge { position: absolute; left: 50%; bottom: 0.9rem; translate: -50% 0; display: grid; place-items: center; width: 2.4rem; height: 2.4rem; border-radius: 999px; background: var(--color-sal); color: var(--color-taronja-2); font-size: 1.35rem; opacity: 0; transform: translateY(6px); transition: opacity 400ms, transform 400ms; }
  .tile.on .badge { opacity: 1; transform: none; }
  .ctl { display: flex; align-items: center; justify-content: center; gap: 0.4rem; height: 2.3rem; }
  .ctl button { display: grid; place-items: center; min-width: 2.2rem; height: 2.2rem; border: 1px solid var(--color-linia); border-radius: 999px; font-size: 1.05rem; transition: border-color 400ms, background-color 400ms, color 400ms; }
  .ctl button:hover { border-color: var(--color-mar); }
  .ctl [data-qty] { min-width: 1.8rem; text-align: center; font-size: 1.4rem; }
  .ctl .afegir { padding: 0 1.1rem; font-size: 0.64rem; font-weight: 500; letter-spacing: 0.26em; text-transform: uppercase; }
  .ctl .afegir:hover { background: var(--color-mar); border-color: var(--color-mar); color: var(--color-sal); }
  .tile:not(.on) .ctl > :not(.afegir) { display: none; }
  .tile.on .ctl .afegir { display: none; }
  .albara { position: relative; background: #f8f3ea; padding: 2.6rem 1.9rem; box-shadow: 0 30px 60px -40px rgb(42 33 27 / 0.45); }
  .albara::before { content: ''; position: absolute; inset: 0.6rem; border: 1px solid var(--color-linia); pointer-events: none; }
  @media (min-width: 640px) { .albara { padding: 3rem 2.6rem; } }
</style>
