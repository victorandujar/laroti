---
import { Image } from 'astro:assets';
import clasico from '../assets/productos/clasico.jpg';
import cruasan from '../assets/productos/cruasan.jpg';
import ceramica from '../assets/productos/ceramica.jpg';
import { ui, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const tx = ui[lang].obrador;
---
<section id="obrador" aria-labelledby="obr-t" class="scroll-mt-20">
  <div class="mx-auto grid max-w-[90rem] gap-14 px-5 py-24 sm:px-10 sm:py-32 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-5 lg:pt-10">
      <p class="label hoja text-gris" data-reveal>{tx.label}</p>
      <h2 id="obr-t" class="titol mt-6 text-[clamp(2.7rem,5vw,4.6rem)]" data-reveal style="--i:1" set:html={tx.h2} />
      <p class="mt-8 max-w-md text-gris" data-reveal style="--i:2">{tx.p1}</p>
      <p class="mt-4 max-w-md text-gris" data-reveal style="--i:3">{tx.p2}</p>
      <ul class="mt-10 grid max-w-md grid-cols-2 border-t border-linia" data-reveal style="--i:4">
        {tx.puntos.map((t, i) => <li class={`border-b border-linia py-4 text-sm ${i % 2 ? 'pl-5' : 'border-r pr-5'}`}><span class="num mr-2 text-gris">0{i + 1}</span>{t}</li>)}
      </ul>
    </div>
    <div class="grid grid-cols-12 gap-4 lg:col-span-7 lg:gap-5">
      <div class="col-span-8" data-reveal="foto">
        <Image src={clasico} alt={tx.alt1} widths={[500, 800, 1100]} sizes="(min-width: 1024px) 38vw, 64vw" loading="lazy" class="aspect-[4/5] w-full object-cover" />
      </div>
      <div class="col-span-4 flex flex-col justify-end gap-4 lg:gap-5">
        <div data-reveal="foto" style="--i:1">
          <Image src={cruasan} alt={tx.alt2} widths={[300, 500]} sizes="(min-width: 1024px) 18vw, 32vw" loading="lazy" class="aspect-[3/4] w-full object-cover" />
        </div>
        <figure data-reveal="foto" style="--i:2">
          <Image src={ceramica} alt={tx.ceramica} widths={[300, 500]} sizes="(min-width: 1024px) 18vw, 32vw" loading="lazy" class="aspect-square w-full object-cover" />
        </figure>
      </div>
      <figcaption class="col-span-12 grid gap-1 border-t border-linia pt-4 text-sm sm:col-span-8 sm:col-start-5" data-reveal>
        <span class="titol text-[1.35rem] leading-tight">{tx.ceramica}</span>
        <span class="text-gris">{tx.ceramicaT}</span>
      </figcaption>
    </div>
  </div>
</section>
<style is:global>#obr-t em { font-style: normal; color: var(--color-taronja-2); }</style>
