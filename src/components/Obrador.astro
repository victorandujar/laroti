---
import { Image } from 'astro:assets';
import focaccia from '../assets/productos/focaccia.jpg';
import ceramica from '../assets/productos/ceramica.jpg';
import Espiga from './Espiga.astro';
import { ui, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const tx = ui[lang].obrador;
---
<section id="obrador" aria-labelledby="obr-t" class="scroll-mt-20">
  <div class="mx-auto grid max-w-[88rem] items-center gap-20 px-5 py-28 sm:px-10 sm:py-36 lg:grid-cols-12 lg:gap-10">
    <div class="relative lg:col-span-5 lg:col-start-2">
      <div class="arc mx-auto max-w-md" data-reveal="foto"><div class="arc-in"><Image src={focaccia} alt={tx.alt1} widths={[420, 640, 900]} sizes="(min-width: 1024px) 32vw, 90vw" loading="lazy" class="aspect-[3/4] w-full object-cover" /></div></div>
      <figure class="absolute -bottom-10 -right-1 w-[38%] max-w-[12rem] border-[0.6rem] border-sal shadow-[0_20px_40px_-25px_rgb(42_33_27/0.6)] sm:right-0" data-reveal="foto" style="--i:2">
        <Image src={ceramica} alt={tx.ceramica} widths={[240, 400]} sizes="12rem" loading="lazy" class="aspect-square w-full object-cover" />
      </figure>
    </div>
    <div class="lg:col-span-5 lg:col-start-8">
      <p class="label text-taronja-2" data-reveal>{tx.label}</p>
      <h2 id="obr-t" class="titol mt-6 text-[clamp(2.7rem,5vw,4.6rem)]" data-reveal style="--i:1" set:html={tx.h2} />
      <p class="mt-8 max-w-md text-gris" data-reveal style="--i:2">{tx.p1}</p>
      <p class="mt-4 max-w-md text-gris" data-reveal style="--i:3">{tx.p2}</p>
      <div class="mt-12 flex max-w-md items-start gap-5 border-t border-linia pt-7" data-reveal style="--i:4">
        <Espiga class="h-16 w-6 shrink-0 text-taronja-2" granos={4} aristas={false} />
        <p><span class="titol block text-[1.5rem]">{tx.ceramica}</span><span class="mt-1 block text-[0.95rem] text-gris">{tx.ceramicaT}</span></p>
      </div>
    </div>
  </div>
</section>
<style is:global>#obr-t em { color: var(--color-taronja-2); }</style>
