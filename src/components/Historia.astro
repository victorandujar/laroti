---
/** Su historia, en cuatro hitos, y su Mallorca en un mapa dibujado a línea. */
import { Image } from 'astro:assets';
import manos from '../assets/fotos/manos2.jpg';
import Espiga from './Espiga.astro';
import { costa, hitos, lugares } from '../data/historia';
import { ui, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const tx = ui[lang].historia;

// Proyección sencilla (equirectangular corregida por la latitud media)
const K = 620, LON0 = 2.3, LAT0 = 40.0, C = Math.cos((39.6 * Math.PI) / 180);
const px = (lat: number, lon: number) => [(lon - LON0) * C * K, (LAT0 - lat) * K] as const;
const pts = costa.map(([la, lo]) => px(la, lo));
// Curva suave (Catmull-Rom cerrada)
const d = pts.map((p, i) => {
  const p0 = pts[(i - 1 + pts.length) % pts.length]!, p1 = p, p2 = pts[(i + 1) % pts.length]!, p3 = pts[(i + 2) % pts.length]!;
  const c1 = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6], c2 = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
  return `${i === 0 ? `M${p1[0].toFixed(1)} ${p1[1].toFixed(1)}` : ''} C${c1[0]!.toFixed(1)} ${c1[1]!.toFixed(1)} ${c2[0]!.toFixed(1)} ${c2[1]!.toFixed(1)} ${p2[0].toFixed(1)} ${p2[1].toFixed(1)}`;
}).join(' ') + ' Z';
const llocs = lugares.map((l) => { const [x, y] = px(l.lat, l.lon); return { ...l, x, y, txt: l[lang] }; });
const casa = llocs.find((l) => 'casa' in l)!;
const xs = pts.map((p) => p[0]), ys = pts.map((p) => p[1]);
const vb = `${Math.min(...xs) - 30} ${Math.min(...ys) - 60} ${Math.max(...xs) - Math.min(...xs) + 120} ${Math.max(...ys) - Math.min(...ys) + 110}`;
const nordX = Math.max(...xs) + 50, nordY = Math.min(...ys) - 10;
---
<section id="historia" aria-labelledby="his-t" class="scroll-mt-20">
  <div class="mx-auto max-w-[88rem] px-5 py-28 sm:px-10 sm:py-36">
    <div class="grid gap-16 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-5">
        <div class="lg:sticky lg:top-32">
          <p class="label text-taronja-2" data-reveal>{tx.label}</p>
          <h2 id="his-t" class="titol mt-6 text-[clamp(2.7rem,5vw,4.6rem)]" data-reveal style="--i:1" set:html={tx.h2} />
          <div class="arc mt-14 max-w-sm" data-reveal="foto" style="--i:2">
            <div class="arc-in"><Image src={manos} alt={tx.alt} widths={[400, 640]} sizes="(min-width: 1024px) 24rem, 90vw" loading="lazy" class="aspect-[4/5] w-full object-cover" /></div>
          </div>
          <p class="cursiva mt-8 max-w-sm text-[1.35rem] leading-snug text-gris" data-reveal>{tx.firma}</p>
        </div>
      </div>
      <ol class="relative lg:col-span-6 lg:col-start-7">
        <span class="absolute bottom-6 left-[0.45rem] top-3 w-px bg-linia" aria-hidden="true"></span>
        {hitos.map((h, i) => (
          <li class="relative pb-16 pl-12 last:pb-0" data-reveal style={`--i:${i % 2}`}>
            <span class={`absolute left-0 top-3 size-[0.95rem] rounded-full border border-taronja-2 ${i === hitos.length - 1 ? 'bg-taronja-2' : 'bg-sal'}`} aria-hidden="true"></span>
            <p class="cursiva text-[clamp(3rem,5vw,4.4rem)] leading-none text-taronja-2">{h.any === 'Antes' || h.any === 'Hoy' ? tx.anys[h.any] : h.any}</p>
            <h3 class="titol mt-4 text-[1.9rem]">{h[lang].t}</h3>
            <p class="mt-3 max-w-md text-gris">{h[lang].d}</p>
          </li>
        ))}
      </ol>
    </div>

    <!-- Su Mallorca -->
    <div class="mt-32 grid items-center gap-14 border-t border-linia pt-24 lg:grid-cols-12" data-reveal>
      <div class="lg:col-span-4">
        <Espiga class="h-14 text-taronja-2" granos={4} />
        <h3 class="titol mt-6 text-[clamp(2.3rem,3.8vw,3.4rem)]" set:html={tx.mapaT} />
        <p class="mt-5 max-w-sm text-gris">{tx.mapaD}</p>
        <ul class="mt-8 space-y-4">
          {llocs.map((l, i) => (
            <li class="flex gap-4" data-lloc={l.id}>
              <span class="num mt-0.5 w-6 shrink-0 text-[1.15rem] italic text-taronja-2">{i + 1}</span>
              <p><span class="titol block text-[1.35rem]">{l.txt.t}</span><span class="block text-[0.92rem] text-gris">{l.txt.d}</span></p>
            </li>
          ))}
        </ul>
      </div>
      <div class="lg:col-span-7 lg:col-start-6">
        <svg viewBox={vb} class="mapa h-auto w-full" role="img" aria-label={tx.mapaAria}>
          <defs>
            <pattern id="ratlles" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(35)"><line x1="0" y1="0" x2="0" y2="7" stroke="currentColor" stroke-width="0.6" opacity="0.18" /></pattern>
          </defs>
          <path d={d} fill="url(#ratlles)" class="text-taronja-2" />
          <path d={d} fill="none" stroke="currentColor" stroke-width="1.1" class="costa text-mar" pathLength="1" />
          <path d={d} fill="none" stroke="currentColor" stroke-width="0.6" class="text-mar" opacity="0.25" transform="translate(-6 5)" />
          {llocs.filter((l) => !('casa' in l)).map((l) => (
            <path d={`M${casa.x} ${casa.y} Q${(casa.x + l.x) / 2} ${Math.min(casa.y, l.y) - 40} ${l.x} ${l.y}`} fill="none" stroke="currentColor" stroke-width="0.9" stroke-dasharray="3 5" class="ruta text-taronja-2" />
          ))}
          {llocs.map((l, i) => (
            <g transform={`translate(${l.x.toFixed(1)} ${l.y.toFixed(1)})`} class="pin">
              {'casa' in l ? <circle r="9" fill="var(--color-taronja-2)" /> : <circle r="5.5" fill="var(--color-sal)" stroke="var(--color-taronja-2)" stroke-width="1.4" />}
              {'casa' in l && <circle r="15" fill="none" stroke="var(--color-taronja-2)" stroke-width="0.8" class="ona" />}
              <text x={l.id === 'palma' || l.id === 'trenc' ? -14 : l.id === 'manacor' ? 0 : 14} y={l.id === 'trenc' ? 24 : l.id === 'manacor' ? -16 : -12} text-anchor={l.id === 'palma' || l.id === 'trenc' ? 'end' : l.id === 'manacor' ? 'middle' : 'start'} class="nomlloc">{i + 1} · {l.txt.t}</text>
            </g>
          ))}
          <g transform={`translate(${nordX} ${nordY + 30})`} class="text-mar" aria-hidden="true">
            <path d="M0 -22 L5 0 L0 22 L-5 0 Z" fill="none" stroke="currentColor" stroke-width="0.9" /><path d="M0 -22 L5 0 L-5 0 Z" fill="currentColor" opacity="0.7" />
            <text y="-30" text-anchor="middle" class="nomlloc">N</text>
          </g>
          <text x={Math.min(...xs) + 10} y={Math.max(...ys) + 30} class="cursiva-svg">Mallorca</text>
        </svg>
      </div>
    </div>
  </div>
</section>
<style>
  .nomlloc { font-family: var(--font-serif); font-size: 21px; font-style: italic; fill: var(--color-mar); }
  .cursiva-svg { font-family: var(--font-serif); font-size: 34px; font-style: italic; fill: var(--color-gris); }
  @media (prefers-reduced-motion: no-preference) {
    .is-in .costa { stroke-dasharray: 1; animation: dibuixa 3.4s cubic-bezier(0.6, 0, 0.2, 1) both; }
    @keyframes dibuixa { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
    .ruta { animation: camina 18s linear infinite; }
    @keyframes camina { to { stroke-dashoffset: -160; } }
    .ona { transform-box: fill-box; transform-origin: center; animation: ona 2.8s ease-out infinite; }
    @keyframes ona { from { opacity: 0.9; transform: scale(0.6); } to { opacity: 0; transform: scale(1.8); } }
  }
</style>
<style is:global>#his-t em { color: var(--color-taronja-2); } .mapa h3 em, #historia h3 em { color: var(--color-taronja-2); }</style>
